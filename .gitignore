# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environments
.venv/
venv/

# Local app state and generated outputs
.streamlit/secrets.toml
outputs/
runs/
tmp/
*.log

# Trained model artifacts (keep metadata/configs in Git)
models/*.engine
models/*.torchscript
training/artifacts/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Legacy prototype: a 124 MB binary GitHub refuses outright, plus an RTSP URL
# with the camera password in it. The folder was renamed Ver1/ -> legacy/ and
# these rules did not follow, so both got committed. Ignore the folder itself,
# not the old names.
legacy/

# Model artifacts: gói .zip do notebook Kaggle xuất ra, không phải file nguồn.
# Chỉ commit best.onnx + model_manifest.json; .pt và .zip nằm ngoài Git.
models/*.zip
models/pcb_detector_v2_artifacts.zip
models/pcb_detector_v2_artifacts/
models/pcb_solder_defect_artifacts/

# Ultralytics ghi file cau hinh cuc bo o day: chua UUID may va duong dan
# tuyet doi cua tung nguoi. Thu vien tu ghi lai moi lan chay.
Ultralytics/

# models/library la cho nguoi dung tu de model: khong day len Git, khong
# xung dot khi pull. Giu lai README de thu muc van ton tai sau khi clone.
models/library/*
!models/library/README.md

# 109 MB, trên giới hạn 100 MB của GitHub, và là model ĐÃ BỊ THAY THẾ
# (list_models.py xếp nó là "bản cũ, KHÔNG tự nạp"). Nó ở lại trên ổ đĩa để đối
# chiếu và train lại được từ notebook Kaggle của chính nó; manifest bên cạnh vẫn
# theo dõi trong git nên số đo và sha256 của nó không mất.
models/archive/solder-segmenter-yolov8m-ver1/best.onnx

# Ultralytics tải trọng số gốc về thư mục đang đứng khi gọi YOLO("yolo11n.pt").
# Chúng là bản tải lại được, không phải artifact của dự án, và một lần chạy
# benchmark ở thư mục gốc là đủ để chúng lọt vào commit.
/yolo*.pt
/yolo*.yaml

# Ảnh nền của app duyệt PnP: sinh lại được từ golden.png bằng
# scripts/build_pnp_review_app.py. Chỉ là phương tiện xem, không phải dữ liệu
# gắn nhãn, và nó là bản JPEG ~2.3MB của một file đã có trong repo.
datasets/reference_sets/*/review/board.jpg

# Dataset tải từ nguồn ngoài. Không commit ảnh của người khác vào repo này:
# Ulger solder-joint-dataset không có LICENSE (kiểm 2026-08-25, GitHub API trả
# license=null) nên mặc định tác giả giữ toàn quyền, và các nguồn Kaggle có
# điều khoản riêng. Chỉ README.md mô tả nguồn là được theo dõi.
datasets/public/*
!datasets/public/README.md

# Component crops cut for step-6.2 labelling: hundreds of megabytes of pixels
# that crop_components_for_labelling.py reproduces from the public sets. The
# manifest and provenance are small and are what makes that reproducible, so
# they stay.
datasets/labelling/*/crops/
# Mọi trang gán nhãn dựng ra, không riêng label_boxes.html: trang package
# (`label_packages.html`, 720 KB) lọt qua khuôn cũ và suýt vào git. Trang nào
# cũng nhúng ảnh và cũng dựng lại được từ draft + crops bằng
# build_joint_box_app.py, nên khuôn phải bắt theo tiền tố chứ không theo tên.
datasets/labelling/*/label_*.html
# Handoff bundle của workspace gán nhãn cũng chứa chính các crop ở trên. File
# hiện tại ~221 MB (GitHub chặn file thường >100 MB) và ảnh CVL PCB-DSLR chỉ
# được dùng cho nghiên cứu phi thương mại, nên không phát hành lại qua repo.
datasets/labelling/*.zip

# Packed training sets: pixels and the zip built from them. Both are rebuilt by
# pack_joint_detection_dataset.py from the crop folders plus the exported
# labels, and the pack_manifest is what makes that reproducible -- so the
# manifest stays and the 150 MB of images does not.
datasets/train/*/train/
datasets/train/*/valid/
datasets/train/*/test/
datasets/train/*.zip

# Ảnh board để test: hàng trăm MB ảnh chụp, tải lại được bằng
# scripts/fetch_test_board_images.py. Bộ CVL PCB DSLR còn giới hạn nghiên cứu
# phi thương mại nên không được đẩy lên repo. README và manifest thì giữ.
datasets/test_images/*/
datasets/test_images/*.json

# Khảo sát taxonomy package: 336 MB ảnh crop, contact sheet và một CSV 26 MB
# dòng-một-box. scripts/survey_package_taxonomy.py dựng lại được toàn bộ từ hai
# zip công khai, và bảng tổng đã rút gọn nằm ở Docs/khao_sat/.
datasets/survey/
# ...trừ nhãn và bảng tổng: đó là công gán tay, nhẹ, và là thứ duy nhất không
# dựng lại được bằng script.
!datasets/survey/*/prelabels.json
!datasets/survey/*/labels/
!datasets/survey/*/labels/*.json
